# ------------------------------------------------
# Application
# ------------------------------------------------
APP_NAME="Blog_App"
APP_ENV=local                   # local | staging | production
APP_KEY=                        # Run: php artisan key:generate
APP_DEBUG=true                  # Set to false in production
APP_URL=http://localhost:8000   # Full URL of the server (no trailing slash)
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12                # Increase to 14+ in production

# ------------------------------------------------
# Database
# ------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_app_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------
# Cache
# ------------------------------------------------
CACHE_STORE=database            # database | redis | memcached | array
# CACHE_PREFIX=

# ------------------------------------------------
# Session
# ------------------------------------------------
SESSION_DRIVER=database         # database | redis | cookie | file
SESSION_LIFETIME=120            # Minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------
# Queue
# ------------------------------------------------
QUEUE_CONNECTION=database       # database | redis | sync

# ------------------------------------------------
# Broadcasting
# ------------------------------------------------
BROADCAST_CONNECTION=log        # log | pusher | reverb

# ------------------------------------------------
# Filesystem / Storage
# ------------------------------------------------
FILESYSTEM_DISK=local           # local | s3
# For S3 (production recommended):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=your-s3-bucket-name
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------
# Redis (optional - recommended for production)
# ------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------
# Mail
# ------------------------------------------------
MAIL_MAILER=log                 # log | smtp | mailgun | ses
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------
# Firebase / FCM (Push Notifications)
# ------------------------------------------------
# Download your Firebase service account credentials JSON from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Save the file locally (never commit it!) and set the path below.
FIREBASE_CREDENTIALS=storage/app/firebase_credentials.json

# ------------------------------------------------
# Logging
# ------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single                # single | daily | slack | syslog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                 # debug | info | warning | error (use 'error' in production)

# ------------------------------------------------
# Sanctum (API Authentication)
# ------------------------------------------------
# For cross-domain SPA authentication, uncomment and set:
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ------------------------------------------------
# Swagger / API Documentation
# ------------------------------------------------
# L5_SWAGGER_GENERATE_ALWAYS=true  # Set to false in production
